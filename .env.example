DATABASE_URL="postgresql://user:password@localhost:5432/fieldday?schema=public"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

PUBNUB_PUBLISH_KEY="pub-c-..."
NEXT_PUBLIC_PUBNUB_SUBSCRIBE_KEY="sub-c-..."
PUBNUB_SECRET_KEY="sec-c-..."

# --- S3 (image upload + retrieval) ---
AWS_REGION="us-east-1"
S3_BUCKET="field-day-photos"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional: set when fronting the bucket with CloudFront or a custom domain.
# When set, public URLs are built as `${S3_PUBLIC_BASE_URL}/${key}` instead of
# the default `https://${S3_BUCKET}.s3.${AWS_REGION}.amazonaws.com/${key}`.
S3_PUBLIC_BASE_URL=""

SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme"
